# EXAMVAN Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
# WAJIB: Set secret key minimal 32 karakter — server TIDAK akan startup tanpa ini!
# WARNING: Jangan gunakan nilai placeholder. Server akan exit dengan error jika placeholder terdeteksi.
EXAMVAN_SECRET=
PORT=5000

# PostgreSQL Connection (required for PostgreSQL mode)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://examvan:YOUR_DB_PASSWORD@localhost:5432/examvan

# SQLite Fallback (used if DATABASE_URL is not set)
# DATABASE_PATH=server/data/examvan.db

# Redis Connection (optional — for session storage, heartbeat, caching)
# Format: redis://host:port/database
# REDIS_URL=redis://localhost:6379/0

# Android Signing (for local builds)
EXAMVAN_KEY_ALIAS=releasekey
EXAMVAN_KEY_PASSWORD=
EXAMVAN_KEYSTORE_PATH=release.keystore
EXAMVAN_STORE_PASSWORD=

# Admin Account (leave empty to generate random password on first run, or set explicitly)
# NOTE: Jika tidak diset, password RANDOM akan digenerate dan ditulis ke log server
EXAMVAN_ADMIN_USER=superadmin
EXAMVAN_ADMIN_PASS=

# CORS Allowed Origins (comma-separated, e.g. https://examvan.example.com,http://192.168.1.100:5000)
# Biarkan kosong untuk mengizinkan semua origin (tidak direkomendasikan untuk produksi)
EXAMVAN_CORS_ORIGINS=

# WhatsApp Gateway (Fonnte API)
WA_API_TOKEN=

# Cloudflare Tunnel (optional — for public HTTPS access)
TUNNEL_TOKEN=

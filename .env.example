# EXAMVAN Configuration

# Secret key for server security
EXAMVAN_SECRET=examvan_super_secret_key_change_me
PORT=5000

# Cloudflare Tunnel Configuration
# If TUNNEL_TOKEN is set (not empty), the project will run in ONLINE mode through Cloudflare Tunnel.
# If TUNNEL_TOKEN is empty or commented out, the project will run in OFFLINE mode (LAN only).
# In Cloudflare Zero Trust, configure your tunnel's public hostname to route to: http://examvan-server:5000
TUNNEL_TOKEN=

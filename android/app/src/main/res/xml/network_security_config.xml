<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow cleartext (HTTP) for private LAN IP ranges using proper CIDR notation.
        NOTE: <ip-range> requires API 24+ (minSdk 21 fallback uses <base-config> below).
    -->
    <domain-config cleartextTrafficPermitted="true">
        <ip-range>10.0.0.0/8</ip-range>
        <ip-range>172.16.0.0/12</ip-range>
        <ip-range>192.168.0.0/16</ip-range>
        <ip-range>127.0.0.0/8</ip-range>
    </domain-config>

    <!-- Default: disallow cleartext for non-LAN traffic (token moved to HTTP header, not URL query) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

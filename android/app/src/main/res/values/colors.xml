<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light mode — EXAMVAN clean light palette -->
    <!-- Brand colors (same across both modes) -->
    <color name="primary">#6366F1</color>
    <color name="primary_dark">#4F46E5</color>
    <color name="primary_variant">#8B5CF6</color>
    <color name="on_primary">#FFFFFF</color>

    <!-- Background & Surface — clean light tones -->
    <color name="background">#F8FAFC</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#F1F5F9</color>
    <color name="on_background">#0F172A</color>
    <color name="on_surface">#1E293B</color>

    <!-- Text — dark on light, WCAG AA ≥ 7:1 -->
    <color name="text_secondary">#64748B</color>
    <color name="text_muted">#94A3B8</color>

    <!-- Semantic colors -->
    <color name="success">#10B981</color>
    <color name="danger">#EF4444</color>
    <color name="warning">#F59E0B</color>

    <!-- Cards & Dividers -->
    <color name="card_bg">#FFFFFF</color>
    <color name="divider">#E2E8F0</color>

    <!-- Status indicators -->
    <color name="status_active_bg">#ECFDF5</color>
    <color name="status_inactive_bg">#FFFBEB</color>

    <!-- Input fields — light mode -->
    <color name="input_background">#F1F5F9</color>
    <color name="input_border">#CBD5E1</color>
    <color name="input_fill">#F8FAFC</color>

    <!-- ============================================================
         Named colors for elements that were previously hardcoded.
         Dark-mode counterparts live in values-night/colors.xml.
         ============================================================ -->

    <!-- Drawable backgrounds — approval / identity / status -->
    <color name="approval_circle_bg">#EEF2FF</color>
    <color name="identity_badge_bg">#F1F5F9</color>
    <color name="status_warning_bg">#FEF3C7</color>
    <color name="status_warning_stroke">#FCD34D</color>
    <color name="status_rejected_bg">#FEE2E2</color>
    <color name="status_rejected_stroke">#FECACA</color>

    <!-- Contextual text on semantic backgrounds -->
    <color name="warning_text">#92400E</color>
    <color name="danger_text">#991B1B</color>
    <color name="timer_text">#E53935</color>

    <!-- Security banner (ExamViewerActivity) -->
    <color name="security_banner_critical">#B71C1C</color>
    <color name="security_banner_warning">#D32F2F</color>
    <color name="security_banner_info">#455A64</color>
    <color name="security_banner_text">#FFFFFF</color>

    <!-- Hint colors for dynamically-styled EditTexts (AnswerSheetBuilder) -->
    <color name="hint_on_dark_panel">#B0FFFFFF</color>
    <color name="hint_on_light_panel">#80000000</color>
</resources>

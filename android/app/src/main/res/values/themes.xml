<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ExamVan" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSecondary">@color/primary_dark</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/on_primary</item>
        <item name="colorOnBackground">@color/on_background</item>
        <!-- Di API 35+ (targetSdk 35) dua warna ini diabaikan karena
             edge-to-edge dipaksa (bar transparan) — dipertahankan untuk API < 35. -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <!-- Light mode: dark icons di atas background terang (termasuk nav bar
             transparan di edge-to-edge API 35, agar ikon tidak tak terlihat) -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- windowLightNavigationBar butuh API 27; di API 24-26 atribut
             diabaikan aman oleh sistem (lint NewApi diredam eksplisit). -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>

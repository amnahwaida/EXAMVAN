<?xml version="1.0" encoding="utf-8"?>
<!--
  Background shape untuk panel/layout konten.
  Menggunakan transparent fill agar tidak double-background
  dengan AlertDialog / BottomSheet dari MaterialComponents theme.
  Stroke border tetap memberikan definisi visual.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="@color/divider" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tutup ujian"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvExamTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#E53935"
            android:layout_marginEnd="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Security / Auto-Submit Status Strip -->
    <TextView
        android:id="@+id/tvSecurityBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@color/surface_variant"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PDF View Area -->
    <com.examvan.app.view.ZoomableImageView
        android:id="@+id/ivPdfPage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        android:contentDescription="Halaman PDF ujian"
        app:layout_constraintTop_toBottomOf="@id/tvSecurityBanner"
        app:layout_constraintBottom_toTopOf="@id/answerSheetToggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Download Progress Overlay -->
    <LinearLayout
        android:id="@+id/layoutDownload"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/background"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/tvSecurityBanner"
        app:layout_constraintBottom_toTopOf="@id/answerSheetToggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressDownload"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/surface_variant" />

        <TextView
            android:id="@+id/tvDownloadPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvDownloadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mengunduh soal ujian..."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Batal"
            android:textSize="13sp"
            android:backgroundTint="@color/danger"
            android:textColor="@color/on_primary"
            android:layout_marginTop="20dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Error Overlay -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/background"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvSecurityBanner"
        app:layout_constraintBottom_toTopOf="@id/answerSheetToggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvErrorMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_download"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="32dp" />

        <Button
            android:id="@+id/btnRetryDownload"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/btn_retry"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            android:paddingHorizontal="32dp" />

        <Button
            android:id="@+id/btnOpenResult"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/congrats_open_result"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/primary"
            android:paddingHorizontal="32dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Answer Sheet Toggle Bar -->
    <LinearLayout
        android:id="@+id/answerSheetToggle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/surface"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/answerSheetPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnToggleAnswerSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/answer_sheet_open"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_dark"
            android:textColor="@color/on_primary" />
    </LinearLayout>

    <!-- Answer Sheet Panel (collapsible bottom sheet) -->
    <LinearLayout
        android:id="@+id/answerSheetPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/surface"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.45">

        <!-- Scrollable Answer List -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/answerListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitAnswers"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/submit_answers_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/success"
            android:textColor="@color/on_primary"
            android:layout_margin="12dp" />
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/surface"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/btn_prev"
            android:textSize="13sp"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/text_secondary"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="Halaman sebelumnya"
            android:enabled="false" />

        <TextView
            android:id="@+id/tvPageCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/btn_next"
            android:textSize="13sp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="Halaman berikutnya" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

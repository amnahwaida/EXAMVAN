<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Identitas Peserta Ujian"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Silakan isi data diri Anda dengan benar sebelum memulai ujian."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Name Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nama Lengkap"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etStudentName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Contoh: Budi Santoso"
        android:inputType="textPersonName|textCapWords"
        android:textSize="14sp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/text_muted"
        android:background="@color/surface_variant"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <!-- Exam Number Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nomor Ujian / NISN"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etStudentNumber"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Contoh: 202609001"
        android:inputType="text"
        android:textSize="14sp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/text_muted"
        android:background="@color/surface_variant"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <!-- Class Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kelas"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etStudentClass"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Contoh: XII IPA 1"
        android:inputType="textCapCharacters"
        android:textSize="14sp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/text_muted"
        android:background="@color/surface_variant"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:layout_marginBottom="24dp" />

    <!-- Error Text -->
    <TextView
        android:id="@+id/tvDialogError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/danger"
        android:visibility="gone"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Button Confirm -->
    <Button
        android:id="@+id/btnConfirmStart"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Mulai Sekarang"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary"
        android:textColor="@color/on_primary" />

</LinearLayout>

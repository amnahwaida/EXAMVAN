# Gradle files
.gradle/
build/
app/build/
*.iml
.idea/
local.properties

# Keystore files — NEVER commit these
*.keystore
*.jks
*.p12

# Python/Flask files
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv
env/
venv/
server/examvan.db
server/data/*
!server/data/.gitkeep
server/storage/*
!server/storage/.gitkeep

# OS files
.DS_Store
Thumbs.db
node_modules/
package-lock.json

# APK binary files — use GitHub Releases instead
*.apk

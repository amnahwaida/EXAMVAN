# Gradle files
.gradle/
build/
app/build/
*.iml
.idea/
local.properties

# Keystore files — NEVER commit these
*.keystore
*.jks
*.p12

# Python/Flask files
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv
env/
venv/
server/examvan.db
server/data/*
!server/data/.gitkeep
server/storage/*
!server/storage/.gitkeep

# OS files
.DS_Store

# Build artifacts Windows — exe didapat dari release GitHub 'exe-latest'
# (di-build otomatis CI), tidak di-commit agar riwayat repo tetap ramping
windows/dist/

# Build artifacts Linux — .deb dibangun ulang dengan desktop/build-deb.sh
# dari desktop/examvan/ (satu sumber kebenaran). Binary yang pernah
# di-commit justru build LAMA, bukan hasil source terkini — .deb 1.0.0
# sempat ships APP_VERSION 2.2.0 sementara source sudah 2.5.0.
desktop/dist/

Thumbs.db
node_modules/
package-lock.json

# APK binary files — use GitHub Releases instead
*.apk
.claude/
.qoder/

# Local screenshots
Screenshot_*.jpg
Screenshot_*.png

# Go binaries
webui/main
webui/server
webui/examvan-server

# Database backups — never commit production dumps
backups/

# EXAMVAN WebUI Environment Configuration
# Copy this file to .env and fill in your values.

# ============================================================
# Server Configuration
# ============================================================

# WAJIB: Secret key minimal 32 karakter untuk session encryption.
# Server TIDAK akan startup tanpa ini.
# Ganti dengan string acak minimal 32 karakter sebelum production!
EXAMVAN_SECRET=change_me_to_a_random_string_at_least_32_chars

# Port to listen on (default: 5000)
PORT=5000

# Application environment (development / production)
# Set to "development" for debug mode.
APP_ENV=production

# Storage path for uploaded PDF files (default: ./storage)
STORAGE_PATH=./storage

# ============================================================
# PostgreSQL Database
# ============================================================
# Format: postgresql://user:password@host:port/database
# Biarkan kosong jika tidak ingin menggunakan PostgreSQL.
# NOTE: Tanpa DATABASE_URL server tetap berjalan tetapi sebagian besar fitur
# tidak akan tersedia.
DATABASE_URL=postgresql://examvan:YOUR_DB_PASSWORD@localhost:5432/examvan

# ============================================================
# Redis (optional — for queue, caching, rate limiting, heartbeat)
# ============================================================
# Format: redis://host:port/database
# Biarkan kosong untuk menonaktifkan fitur Redis (antrean submit,
# caching, distributed rate limit, heartbeat monitoring).
# REDIS_URL=redis://localhost:6379/0

# ============================================================
# Admin Account
# ============================================================
# Username untuk super admin (default: superadmin)
EXAMVAN_ADMIN_USER=superadmin

# Password untuk super admin. Biarkan kosong untuk generate random
# pada first run (password akan ditampilkan di log).
EXAMVAN_ADMIN_PASS=

# ============================================================
# CORS
# ============================================================
# Comma-separated allowed origins (e.g. https://examvan.example.com)
# Biarkan kosong untuk mengizinkan semua origin (tidak disarankan untuk produksi).
# EXAMVAN_CORS_ORIGINS=

# ============================================================
# WhatsApp Gateway (Fonnte API)
# ============================================================
# WA_API_TOKEN=

# ============================================================
# Cloudflare R2 (optional — PDF offloading to edge CDN)
# ============================================================
# Jika dikonfigurasi, PDF akan diupload ke R2 dan di-serve via
# signed URL (redirect). Bandwidth VPS menjadi nol untuk PDF.
# Biarkan kosong untuk mode lokal (PDF di-serve dari disk).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=examvan-pdfs
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# ============================================================
# Cloudflare Tunnel (optional — for public HTTPS access)
# ============================================================
# TUNNEL_TOKEN=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://examvan.local/contracts/questions_v1.schema.json",
  "title": "EXAMVAN Questions Contract v1",
  "description": "Canonical questions payload emitted by the SERVER to clients. Android and Go must consume this shape. Legacy aliases are accepted only as input and are normalized before storing or sending.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/question"
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "type", "weight", "partial_scoring"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "Unique 1-based question number. Invalid legacy numbers are replaced with the first unused positional number."
        },
        "type": {
          "enum": [
            "single_choice",
            "multiple_choice",
            "true_false",
            "short_answer",
            "matching"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "partial_scoring": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "deprecated": true,
          "description": "Compatibility mirror of choices for older Go consumers. Always identical to choices."
        },
        "statements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "left_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "right_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "numbering": {
          "enum": ["single", "range"],
          "description": "Matching only. single = the whole matching card uses one question number; range = each left item consumes one number (N..N+len(left_items)-1)."
        },
        "key": {
          "description": "Answer key. SERVER-ONLY: the public student endpoint strips this field before responding."
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["single_choice", "multiple_choice"]
              }
            }
          },
          "then": {
            "required": ["choices"]
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": {
                "const": "matching"
              }
            }
          },
          "then": {
            "required": ["left_items", "right_items"]
          }
        }
      ]
    }
  }
}

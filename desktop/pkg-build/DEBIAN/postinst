#!/bin/bash
set -e

# Create virtual environment and install Python dependencies
VENV_DIR=/opt/examvan/.venv
python3 -m venv --system-site-packages "$VENV_DIR"
"$VENV_DIR/bin/pip" install --upgrade pip --quiet
"$VENV_DIR/bin/pip" install -r /opt/examvan/requirements.txt --quiet

# Install PyMuPDF if not available via apt
if ! python3 -c "import fitz" 2>/dev/null; then
    "$VENV_DIR/bin/pip" install PyMuPDF --quiet
fi

# Clean old bytecode
find /opt/examvan -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
find /opt/examvan -name "*.pyc" -delete 2>/dev/null || true

# Register kiosk session
if [ -f /usr/share/xsessions/examvan-kiosk.desktop ]; then
    chmod 644 /usr/share/xsessions/examvan-kiosk.desktop
fi

exit 0

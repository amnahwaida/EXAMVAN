#!/usr/bin/env bash
# EXAMVAN Linux Client — system launcher
#
# Wrapper tipis. Seluruh logika ada di /opt/examvan/run.sh, termasuk
# handling --kiosk / --kiosk-session yang butuh Xephyr + Openbox.
#
# Kenapa tidak lagi `exec python -m examvan "$@"` di sini seperti versi
# sebelumnya: --kiosk-session hanya sampai ke argparse-nya, yang
#álisnya cuma nyalakan satu boolean di examvan/__main__.py:83, dan
# boolean itu HANYA dibaca enforcer.py:241 di dalam _activate_strict().
# Artinya entri xsessions/ (dipakai untuk memilih sesi kiosk di layar
# login) menjalankan aplikasi TANPA sandbox — persis kebalikan dari yang
# oe_name  promise-kan. Diteruskan ke run.sh, yang memanggil
# examvan.security.kiosk.launch_kiosk_session() untuk melaksanakannya.
set -e

APP_DIR=/opt/examvan

if [ ! -x "$APP_DIR/run.sh" ]; then
    echo "ERR: $APP_DIR/run.sh tidak ditemukan. Coba pasang ulang paket:" >&2
    echo "  sudo dpkg -i --reinstall examvan-linux_*.deb" >&2
    exit 1
fi

exec "$APP_DIR/run.sh" "$@"
